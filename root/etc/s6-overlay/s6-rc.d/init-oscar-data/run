#!/usr/bin/python3
"""Initialize only fresh OSCAR directory roots, never existing user data.

SPDX-License-Identifier: Apache-2.0
Runs after base UID/GID setup, before desktop services. One volume writer required.
"""
from contextlib import contextmanager
import os
import pwd


@contextmanager
def directory(path, *, parent=None):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
    try:
        yield fd
    finally:
        os.close(fd)


@contextmanager
def managed_directory(parent, name, uid, gid):
    created = False
    try:
        os.mkdir(name, mode=0o755, dir_fd=parent)
        created = True
    except FileExistsError:
        pass
    with directory(name, parent=parent) as fd:
        if created:
            os.fchown(fd, uid, gid)
        yield fd, created


def initialize(config, uid, gid):
    # Descriptor-relative, no-follow traversal prevents chown through symlinks.
    # Existing parent directories keep their permissions and ownership.
    with directory(config) as home:
        with managed_directory(home, "Documents", uid, gid) as (documents, _):
            with managed_directory(documents, "OSCAR20_Data", uid, gid) as (data, created):
                if created or os.fstatvfs(data).f_flag & os.ST_RDONLY:
                    return
                owner = os.fstat(data)
                # Fresh named volumes/PVC roots are root:root. Even a hidden
                # entry or lost+found makes this existing data: do not touch it.
                if owner.st_uid == 0 and owner.st_gid == 0 and not os.listdir(data):
                    os.fchown(data, uid, gid)


if __name__ == "__main__":
    account = pwd.getpwnam("abc")  # actual base-remapped identity, not raw env
    initialize("/config", account.pw_uid, account.pw_gid)
